{
  "name": "dsh-pet-douyin-live",
  "version": "0.4.0",
  "type": "module",
  "description": "抖音直播间弹幕/礼物 → dsh-pet 气泡 + 语音朗读。带设置页、对话记录，dsh-pet 可选。",
  "main": "./src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "live",
    "danmaku",
    "dsh-pet",
    "tts"
  ],
  "homepage": "https://github.com/liuzhengming/dsh-pet-douyin-live#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuzhengming/dsh-pet-douyin-live.git"
  },
  "bugs": {
    "url": "https://github.com/liuzhengming/dsh-pet-douyin-live/issues"
  },
  "author": "liuzhengming",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/bridge.mjs",
    "say": "node src/bridge.mjs --say",
    "inspect": "node src/inspect.mjs",
    "discover": "node src/discover.mjs",
    "anon-check": "node src/anon-check.mjs",
    "login": "node src/login.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "node-edge-tts": "^1.2.12",
    "playwright-core": "^1.63.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
